HOST=0.0.0.0
PORT=8010
PUBLIC_BASE_URL=
OUTPUT_DIR=./output

# Input limits
PROMPT_MAX_CHARS=2000
REQUEST_MAX_BYTES=16384
DEFAULT_DURATION_MINUTES=2
MIN_DURATION_MINUTES=1
MAX_DURATION_MINUTES=5
MAX_CONCURRENT_GENERATIONS=1

# OpenAI-compatible LLM
LLM_API_KEY=replace_with_your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_CHAT_COMPLETIONS_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
# Qwen3/Qwen3.5 only: send chat_template_kwargs.enable_thinking=false.
LLM_DISABLE_THINKING=true

# Music generation: mock | real
MUSIC_API_MODE=mock
MUSIC_PROVIDER=generic
MOCK_FULL_SONG_PATH=./output/mock_full.mp3
MUSIC_API_KEY=
MUSIC_API_BASE_URL=
MUSIC_GENERATE_PATH=/generate
MUSIC_STATUS_PATH=/generate/status
MUSIC_API_TIMEOUT_SECONDS=240
MUSIC_DOWNLOAD_TIMEOUT_SECONDS=120
MUSIC_POLL_INTERVAL_SECONDS=5
MUSIC_MAX_POLL_ATTEMPTS=60
MUSIC_MODEL=
MUSIC_CALLBACK_URL=

# ElevenLabs: MUSIC_API_MODE=real, MUSIC_PROVIDER=elevenlabs_music
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MUSIC_MODEL_ID=music_v2
ELEVENLABS_MUSIC_OUTPUT_FORMAT=auto
ELEVENLABS_USE_COMPOSITION_PLAN=true
ELEVENLABS_CLEAR_CHINESE_VOCAL_MODE=true
ELEVENLABS_FORCE_INSTRUMENTAL=false
ELEVENLABS_BYPASS_GLOBAL_PROXY=true

# Suno sidecar: MUSIC_API_MODE=real, MUSIC_PROVIDER=suno_api
SUNO_CREATE_TIMEOUT_SECONDS=180
SUNO_MAKE_INSTRUMENTAL=false
SUNO_MODEL=v4.5-all
SUNO_MODEL_FALLBACKS=
SUNO_USE_DEFAULT_MODEL_FALLBACKS=false

# Stem separation
# Demucs 的 mdx_q 和 htdemucs 默认都输出四轨：vocal / drums / bass / other。
# 本地快速验证使用 fast；正式试听建议 balanced。
ENABLE_AUDIO_SPLITTING=false
SPLIT_PROFILE=fast
SPLIT_TIMEOUT_SECONDS=1800
SPLIT_KEEP_WORKDIR=false
DEMUCS_MODEL=
DEMUCS_DEVICE=cuda
DEMUCS_JOBS=
DEMUCS_SHIFTS=
DEMUCS_OVERLAP=
DEMUCS_SEGMENT=
DEMUCS_MP3_BITRATE=

# RVC voice conversion. All assets and results live inside generate_module.
RVC_MODEL_PATH=./assets/rvc/weights/9971-700.pth
RVC_INDEX_PATH=./assets/rvc/indices/9971-700_added_IVF2037_Flat_nprobe_1_9971-700_v2.index
RVC_BASE_MODEL_DIR=./assets/rvc/base_model
RVC_MODEL_VERSION=v2
RVC_DEVICE=cuda:0
RVC_CPU_THREADS=6
RVC_MAX_UPLOAD_MB=50
RVC_RESULT_DIR=./output/rvc

# Reserved infrastructure hooks. Local mode does not require Redis or a queue.
TASK_BACKEND=inline
CACHE_BACKEND=none
EVENT_BACKEND=none
# REDIS_URL=redis://localhost:6379/0
# QUEUE_NAME=ai-music-generation
# CACHE_DEFAULT_TTL_SECONDS=3600

# CORS: comma-separated origins, or * for local compatibility
CORS_ORIGINS=*
